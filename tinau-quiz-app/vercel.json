{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --dir frontend",
  "buildCommand": "pnpm --dir frontend build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
